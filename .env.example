# Discord application
DISCORD_TOKEN=
CLIENT_ID=

# Leave empty to deploy commands globally; set to a test server ID for instant dev deploys
GUILD_ID=

# Optional: contact email sent with translation requests to raise MyMemory's quota
TRANSLATE_EMAIL=

# Twitch (only needed for /social feeds on Twitch)
# Create an app at https://dev.twitch.tv/console/apps → Manage → New Secret
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=